{
  "name": "lex-minds-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "studio"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:studio": "npm run dev --workspace=studio",
    "build": "npm run build --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:studio": "npm run build --workspace=studio",
    "test": "npm run test --workspace=web",
    "typegen": "npm run typegen --workspace=studio"
  }
}