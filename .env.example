# ==============================================================================
# LexMinds Serverless Submission & Payment Pipeline Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Sheets Integration (Official googleapis Service Account)
# ------------------------------------------------------------------------------
# The Spreadsheet ID found in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Cloud Service Account Email (e.g. lexminds-service@project-id.iam.gserviceaccount.com)
# Make sure to SHARE your Google Sheet with this email address with 'Editor' permissions!
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project_id.iam.gserviceaccount.com

# Google Cloud Service Account Private Key (Found in service account JSON credentials)
# In Vercel and .env.local, wrap with quotes and preserve \n newlines
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Firebase Client Authentication (Sign in with Google)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lexminds-production.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lexminds-production
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lexminds-production.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server-Side ID Token Verification)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=lexminds-production
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lexminds-production.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway (Standard Checkout & Signature Verification)
# ------------------------------------------------------------------------------
# Public Key for Razorpay Checkout popup
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Server-Side Keys for Order Creation and HMAC SHA256 Signature Verification
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
