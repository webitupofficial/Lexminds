# ==============================================================================
# LexMinds MVP Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate the values for your deployment.
# NEVER commit .env.local, service account JSON files, or private keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Mode
# ------------------------------------------------------------------------------
# Options: development | production | test
APP_ENV=development

# Base URL of the deployed application (used for verification links & webhooks)
NEXT_PUBLIC_BASE_URL=https://lexminds.in

# ------------------------------------------------------------------------------
# 2. Administrator Authorization
# ------------------------------------------------------------------------------
# Comma-separated list of verified Google email addresses authorized for
# the /admin dashboard and administrative mutation endpoints (exactly 2 admins)
ADMIN_EMAILS=owner@lexminds.in,editor@lexminds.in

# ------------------------------------------------------------------------------
# 3. Google Sheets Adapter (Private MVP Storage System of Record)
# ------------------------------------------------------------------------------
# The Google Spreadsheet ID from your private Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Cloud Service Account Email
# Ensure the Google Sheet is shared with this email with "Editor" permission
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@your_project_id.iam.gserviceaccount.com

# Google Cloud Service Account Private Key (RSA Private Key from JSON credentials)
# In Vercel and .env.local, wrap with double quotes and preserve \n line breaks
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Firebase Client Authentication (Google Sign-In)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# 5. Firebase Admin SDK (Server-Side ID Token & Admin Verification)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 6. Razorpay Payment Gateway (Standard Checkout & Webhook Verification)
# ------------------------------------------------------------------------------
# Public Key for Razorpay Checkout popup
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere

# Server-Side Key for Order Creation & HMAC SHA-256 Signature Verification
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Secret configured in Razorpay Dashboard for webhook signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 7. Sanity Headless CMS (Editorial Articles & Fellowship Opportunities)
# ------------------------------------------------------------------------------
# Sanity Project ID from Sanity Manage (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# Sanity Dataset (default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Optional read token for draft or private preview queries
SANITY_API_READ_TOKEN=your_sanity_read_token_optional

# ------------------------------------------------------------------------------
# 8. Maintenance & Scheduled Jobs
# ------------------------------------------------------------------------------
# Secret required to invoke /api/maintenance/cleanup-abandoned (Vercel Cron & manual triggers)
CRON_SECRET=your_secure_cron_secret_here

